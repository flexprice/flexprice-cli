{
  "name": "flexprice-cli",
  "version": "0.1.1",
  "description": "A beautiful terminal CLI for the FlexPrice billing platform",
  "license": "MIT",
  "author": "FlexPrice",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flexprice": "./dist/cli-entry.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli-entry.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.4.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ink": "^5.1.0",
    "ora": "^8.1.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
